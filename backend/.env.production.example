# ==============================================================================
# BUILDY GYM API — Production Environment Configuration (.env.production)
# ==============================================================================

APP_NAME="BUILDY GYM API"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_TIMEZONE="Asia/Jakarta"
APP_URL=https://api.buildygym.com

# URL Frontend Production (Digunakan oleh CORS middleware)
FRONTEND_URL=https://buildygym.vercel.app

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# Database Production (Supabase PostgreSQL / Cloud SQL)
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_DATABASE=postgres
DB_USERNAME=postgres.YOUR_PROJECT_REF
DB_PASSWORD=YOUR_STRONG_SUPABASE_PASSWORD
DB_SSLMODE=require

# ------------------------------------------------------------------------------
# Session, Cache, & Queue
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
CACHE_PREFIX=buildygym_cache_

QUEUE_CONNECTION=database

# ------------------------------------------------------------------------------
# File Storage (Public Local atau Cloudflare R2 / Supabase Storage S3)
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=public

# Jalankan migrasi database otomatis saat container start (true/false)
AUTO_MIGRATE=true

# ------------------------------------------------------------------------------
# Mail (Opsional untuk notifikasi transaksi/kontak)
# ------------------------------------------------------------------------------
MAIL_MAILER=log
